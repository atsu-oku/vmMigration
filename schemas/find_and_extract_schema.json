{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/find_and_extract_schema.json",
  "title": "find_and_extract CLI Schema",
  "type": "object",
  "$defs": {
    "CLIOptions": {
      "type": "object",
      "required": ["mode", "target_path"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["scan", "transform"]
        },
        "target_path": {
          "type": "string",
          "description": "Filesystem path to scan or transform."
        },
        "dry_run": {
          "type": "boolean",
          "description": "When true, run transform without persisting changes.",
          "default": false
        },
        "verbose": {
          "type": "boolean",
          "default": false
        },
        "skip_backup_files": {
          "type": "boolean",
          "default": false
        },
        "deletelogs": {
          "type": "boolean",
          "default": false,
          "description": "When true, run in log cleanup mode."
        },
        "output_dir_override": {
          "type": "string",
          "description": "Override the default output directory."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "transform"
              }
            }
          },
          "then": {
            "properties": {
              "dry_run": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "not": {
            "allOf": [
              {
                "required": ["deletelogs"]
              },
              {
                "properties": {
                  "deletelogs": {
                    "const": true
                  },
                  "mode": {
                    "const": "transform"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "TransformRule": {
      "type": "object",
      "required": ["name", "pattern", "replacement"],
      "properties": {
        "name": {
          "type": "string"
        },
        "pattern": {
          "type": "string",
          "description": "POSIX ERE pattern for the search expression."
        },
        "replacement": {
          "type": "string",
          "description": "Replacement text applied by the transform."
        },
        "flags": {
          "type": "string",
          "pattern": "^[a-zA-Z]*$",
          "description": "Regex flags, e.g. i for case-insensitive."
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": ["ip", "hostname", "domain", "custom"]
        },
        "priority": {
          "type": "integer",
          "description": "Lower values execute earlier.",
          "minimum": 0
        }
      }
    },
    "ChangeEntry": {
      "type": "object",
      "required": ["rule_name", "count"],
      "properties": {
        "rule_name": {
          "type": "string"
        },
        "line_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "before_snippet": {
          "type": "string"
        },
        "after_snippet": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TransformResult": {
      "type": "object",
      "required": ["file", "status"],
      "properties": {
        "file": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["unchanged", "changed", "failed"]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeEntry"
          }
        },
        "backup_path": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": ["error"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "changed"
              }
            }
          },
          "then": {
            "required": ["changes"]
          }
        }
      ]
    },
    "RunSummary": {
      "type": "object",
      "required": [
        "start_time",
        "end_time",
        "mode",
        "total_files_scanned",
        "files_changed",
        "files_failed"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "end_time": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "type": "string",
          "enum": ["scan", "transform"]
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        },
        "total_files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "files_changed": {
          "type": "integer",
          "minimum": 0
        },
        "files_failed": {
          "type": "integer",
          "minimum": 0
        },
        "log_paths": {
          "type": "object",
          "properties": {
            "current_infra": {
              "type": "string"
            },
            "new_infra": {
              "type": "string"
            },
            "transform": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
